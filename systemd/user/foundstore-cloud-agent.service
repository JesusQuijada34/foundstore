[Unit]
Description=Cloud Danenone Devices agent for Foundstore
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/flut cloud daemon
Restart=always
RestartSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only

[Install]
WantedBy=default.target
